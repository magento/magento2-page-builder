<actionGroups xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:noNamespaceSchemaLocation="urn:magento:mftf:Test/etc/actionGroupSchema.xsd">
    <actionGroup name="verifyNumberOfPinsOnMapNoClick">
        <arguments>
            <argument name="page" defaultValue="MapOnStage"/>
            <argument name="mapIndex" defaultValue="1" type="string"/>
            <argument name="count" type="string"/>
        </arguments>
        <waitForElementVisible selector="{{page.googleMapsLink(mapIndex)}}" stepKey="waitForMap"/>
        <executeJS function="return JSON.parse(document.querySelectorAll('[data-content-type=map]')[{{mapIndex}}-1].getAttribute('data-locations') || '[]').length" stepKey="actualPinCount"/>
        <assertEquals stepKey="seeNumberOfPins">
            <expectedResult type="int">{{count}}</expectedResult>
            <actualResult type="variable">actualPinCount</actualResult>
        </assertEquals>
    </actionGroup>
</actionGroups>
