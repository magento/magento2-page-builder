<tests xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:noNamespaceSchemaLocation="urn:magento:mftf:Test/etc/testSchema.xsd">
    <test name="ButtonItemHoverOverButtonItemShowsButtonGroupMenuTest">
        <annotations>
            <features value="PageBuilder"/>
            <stories value="Buttons"/>
            <title value="Button Item - Hovering Over Button Item Shows Button Group Menu"/>
            <description value="A user should see the button group on-hover menu when they hover over a button item."/>
            <severity value="AVERAGE"/>
            <useCaseId value="MC-941"/>
            <testCaseId value="MC-3497"/>
            <group value="pagebuilder"/>
            <group value="pagebuilder-buttons"/>
            <group value="pagebuilder-buttonItem"/>
        </annotations>
        <before>
            <actionGroup ref="AdminLoginActionGroup" stepKey="loginAsAdmin"/>
            <actionGroup ref="navigateToAPageWithPageBuilder" stepKey="navigateToAPageWithPageBuilder"/>
            <actionGroup ref="switchToPageBuilderStage" stepKey="switchToPageBuilderStage"/>
            <actionGroup ref="addPageBuilderPageTitle" stepKey="enterPageTitle">
                <argument name="contentType" value="PageBuilderButtonsContentType"/>
            </actionGroup>
            <actionGroup ref="dragContentTypeToStageWithoutJsErrorCheck" stepKey="dragRowToRootContainer">
                <argument name="contentType" value="PageBuilderRowContentType"/>
                <argument name="containerTargetType" value="PageBuilderRootContainerContentType"/>
            </actionGroup>
        </before>
        <after>
            <actionGroup ref="AdminLogoutActionGroup" stepKey="logout"/>
        </after>
        <actionGroup ref="expandPageBuilderPanelMenuSection" stepKey="expandPageBuilderPanelMenuSection">
            <argument name="contentType" value="PageBuilderButtonsContentType"/>
        </actionGroup>
        <actionGroup ref="dragContentTypeToStageWithoutJsErrorCheck" stepKey="dragButtonsOntoStage">
            <argument name="contentType" value="PageBuilderButtonsContentType"/>
        </actionGroup>
        <!-- Must Click Button Item To Show Menu -->
        <comment userInput="Must Click Button Item To Show Menu" stepKey="commentValidateOptionMenu"/>
        <waitForElementVisible selector="{{ButtonItemOnStage.base('1')}}" stepKey="waitForButtonItemOnStage"/>
        <click selector="{{PageBuilderPanel.searchPanel}}" stepKey="unFocusButtonItemAfterDrag"/>
        <waitForPageLoad stepKey="waitForInteractionStop"/>
        <moveMouseOver selector="{{PageBuilderPanel.searchPanel}}" stepKey="moveMouseAwayBeforeHover"/>
        <moveMouseOver selector="{{ButtonItemOnStage.base('1')}}" stepKey="moveMouseOverButton"/>
        <waitForElementVisible time="10" selector="{{PageBuilderContentTypeOptionsMenu.contentTypeOptionsMenuByIndex(PageBuilderButtonsContentType.role, '1')}}" stepKey="waitForButtonGroupOptionsMenu"/>
        <seeElement selector="{{PageBuilderContentTypeOptionsMenu.contentTypeOptionsMenuByIndex(PageBuilderButtonsContentType.role, '1')}}" stepKey="seeButtonGroupOptionsMenu"/>
        <dontSeeElement selector="{{ButtonItemOnStage.optionsMenu('1')}}" stepKey="dontSeeButtonItemOptionsMenu"/>
        <click selector="{{ButtonItemOnStage.base('1')}}" stepKey="clickButtonItem"/>
        <waitForElementVisible selector="{{ButtonItemOnStage.optionsMenu('1')}}" stepKey="waitForButtonItemOptionsMenuVisible"/>
        <waitForElementNotVisible selector="{{PageBuilderContentTypeOptionsMenu.contentTypeOptionsMenuByIndex(PageBuilderButtonsContentType.role, '1')}}" stepKey="waitForButtonGroupOptionsMenuNotVisible"/>
        <dontSeeElement selector="{{PageBuilderContentTypeOptionsMenu.contentTypeOptionsMenuByIndex(PageBuilderButtonsContentType.role, '1')}}" stepKey="dontSeeButtonGroupOptionsMenu"/>
    </test>
</tests>
